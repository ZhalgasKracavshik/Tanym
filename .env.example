# Скопируйте этот файл в .env.local и подставьте свой ключ.
# Ключ бесплатно выдаётся в Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# Необязательно. Модель по умолчанию — gemini-3.5-flash (самая стабильная на бесплатной квоте).
# Если модель недоступна или перегружена, приложение само пробует запасные
# из цепочки в src/lib/ai/gemini.ts.
GEMINI_MODEL=gemini-3.5-flash

# ОБЯЗАТЕЛЬНО для честного подсчёта прогресса.
# Сервисный ключ Supabase: Project Settings → API keys → service_role.
# Им и только им пишутся проверенные попытки (src/lib/supabase/attempts.ts):
# роут разбора ходит в базу под сессией самого ученика, то есть с теми же
# правами, что и его браузер, и без отдельного ключа подделку из консоли
# не отличить от честного ответа.
# Ключ секретный: он обходит все политики доступа. В браузер не отдавать,
# в репозиторий не коммитить, префикс NEXT_PUBLIC_ не добавлять.
# Без него баллы за задания просто не начисляются.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
