# Скопируйте этот файл в .env.local и подставьте свой ключ.
# Ключ бесплатно выдаётся в Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# Необязательно. Модель по умолчанию — gemini-3.5-flash (самая стабильная на бесплатной квоте).
# Если модель недоступна или перегружена, приложение само пробует запасные
# из цепочки в src/lib/ai/gemini.ts.
GEMINI_MODEL=gemini-3.5-flash
