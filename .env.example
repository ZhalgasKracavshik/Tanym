# Скопируйте этот файл в .env.local и подставьте свой ключ.
# Ключ бесплатно выдаётся в Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# Необязательно. Модель по умолчанию — gemini-3.5-flash (самая стабильная на бесплатной квоте).
# Если модель недоступна или перегружена, приложение само пробует запасные
# из цепочки в src/lib/ai/gemini.ts.
GEMINI_MODEL=gemini-3.5-flash

# ОБЯЗАТЕЛЬНО для честного подсчёта прогресса.
# Сервисный ключ Supabase: Project Settings → API keys → service_role.
# Им и только им пишутся проверенные попытки (src/lib/supabase/attempts.ts):
# роут разбора ходит в базу под сессией самого ученика, то есть с теми же
# правами, что и его браузер, и без отдельного ключа подделку из консоли
# не отличить от честного ответа.
# Ключ секретный: он обходит все политики доступа. В браузер не отдавать,
# в репозиторий не коммитить, префикс NEXT_PUBLIC_ не добавлять.
# Без него баллы за задания просто не начисляются.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Пилот: живая модель Gemini выключена (src/lib/pilot.ts). Разбор, план и
# диалог по архиву отдают детерминированный ответ с пометкой «Разбор без AI».
# Включить модель обратно: AI_LIVE=true (и нужен GEMINI_API_KEY выше).
AI_LIVE=false

# Необязательно. Общий ограничитель частоты записывающих /api/* (Upstash Redis).
# Без них работает счётчик в памяти процесса — на Vercel он у каждого инстанса свой.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Адрес сайта для ссылок «Поделиться» (без слэша в конце).
NEXT_PUBLIC_SITE_URL=https://tanym-alpha.vercel.app

# Напоминания о дедлайнах (src/app/api/cron/deadline-reminders, vercel.json).
# CRON_SECRET — любая длинная случайная строка; Vercel Cron сам пришлёт её
# в заголовке Authorization. Без RESEND_API_KEY крон работает вхолостую и
# только показывает, сколько писем ушло бы.
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM=Taným <reminders@your-domain.kz>
